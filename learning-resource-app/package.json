{
  "name": "learning-resource-app",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run desktop:dev",
    "build": "next build",
    "desktop:dev": "electron electron",
    "desktop:build": "npm run build && node scripts/prepare-desktop.mjs",
    "docling:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-docling-runtime.ps1",
    "desktop:package": "npm run desktop:build && electron-builder --config electron-builder.yml --win nsis",
    "desktop:package:dir": "npm run desktop:build && electron-builder --config electron-builder.yml --dir",
    "test:desktop-runtime": "node scripts/test-desktop-standalone.mjs",
    "test:desktop-packaged": "node scripts/test-packaged-desktop.mjs",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:audio-upload-unit": "node scripts/test-upload-transcription.mjs && node --experimental-strip-types scripts/test-audio-model-separation.mjs && node scripts/test-audio-hybrid-experiment.mjs",
    "pretest:unit": "npm run test:audio-upload-unit && npm run test:ux-regression",
    "test:ux-regression": "node --import tsx scripts/test-ux-regression.mjs",
    "test:unit": "npm run test:xmind && npm run test:xmind-images && npm run test:mindmap-pdf && npm run test:component-manager && npm run test:visual-search && npm run test:vietnamese-ocr && npm run test:hybrid-ocr-routing && npm run test:hybrid-document-extraction && npm run test:media-extractors && npm run test:chunking && npm run test:tag-normalization && npm run test:constrained-classification && npm run test:search-ranking && npm run test:ai-provider-errors && npm run test:embedding-runtime && npm run test:embedding-config && npm run test:processing-estimate && npm run test:local-ai-recommendation && npm run test:local-storage && npm run test:sqlite-database && npm run test:sqlite-vector && npm run test:extractors && npm run test:document-preview && npm run test:processing-queue",
    "test:integration": "npm run test:semantic-search && npm run test:canonical-tags && npm run test:tag-similarity && npm run test:ai-providers",
    "test:extractors": "node --experimental-strip-types scripts/test-extractors.mjs",
    "test:document-preview": "node --experimental-strip-types scripts/test-document-preview.mjs",
    "test:processing-queue": "node --experimental-strip-types scripts/test-processing-queue.mjs",
    "test:chunking": "node --experimental-strip-types scripts/test-chunking.mjs",
    "backfill:documents": "tsx scripts/backfill-document-processing.ts",
    "embed:documents": "tsx scripts/embed-existing-documents.ts",
    "reprocess:documents": "tsx scripts/reprocess-documents.ts",
    "resume:embeddings": "tsx scripts/resume-embedding-jobs.ts",
    "report:embedding": "tsx scripts/embedding-report.ts",
    "report:locations": "tsx scripts/source-location-report.ts",
    "test:semantic-search": "tsx scripts/semantic-search-smoke.ts",
    "test:hybrid-search": "tsx scripts/hybrid-search-smoke.ts",
    "test:ai-providers": "tsx scripts/ai-provider-smoke.ts",
    "test:tag-normalization": "node --experimental-strip-types scripts/test-tag-normalization.mjs",
    "test:constrained-classification": "node --experimental-strip-types scripts/test-constrained-classification.mjs",
    "test:search-ranking": "node --experimental-strip-types scripts/test-search-ranking.mjs",
    "test:ai-provider-errors": "node --experimental-strip-types scripts/test-ai-provider-errors.mjs && node --import tsx scripts/test-ai-provider-connection.mjs",
    "test:embedding-runtime": "node scripts/test-upload-transcription.mjs && node scripts/test-embedding-runtime.mjs",
    "test:component-manager": "node scripts/test-component-manager.mjs && node --experimental-strip-types scripts/test-audio-model-separation.mjs",
    "test:visual-search": "node --experimental-strip-types scripts/test-visual-search.mjs",
    "test:vietnamese-ocr": "node --experimental-strip-types scripts/test-vietnamese-ocr.mjs",
    "fixtures:hybrid-ocr": "node scripts/generate-hybrid-ocr-fixtures.mjs",
    "fixtures:manual-large-file": "node scripts/generate-manual-large-file.mjs",
    "test:hybrid-ocr-routing": "node --experimental-strip-types scripts/test-hybrid-ocr-routing.mjs",
    "test:hybrid-document-extraction": "node --experimental-strip-types scripts/test-hybrid-document-extraction.mjs",
    "test:media-extractors": "node --experimental-strip-types scripts/test-media-extractors.mjs",
    "test:xmind": "node --experimental-strip-types scripts/test-xmind.mjs",
    "test:xmind-images": "node --experimental-strip-types scripts/test-xmind-images.mjs",
    "test:installed-release": "node scripts/test-installed-release.mjs",
    "test:mindmap-pdf": "node --experimental-strip-types scripts/test-mindmap-pdf.mjs",
    "fixtures:xmind": "node scripts/generate-xmind-fixtures.mjs",
    "test:technical-ocr-modes": "node --experimental-strip-types scripts/test-technical-ocr-modes.mjs",
    "test:visual-capture": "electron scripts/test-electron-visual-capture.cjs",
    "test:embedding-config": "node --experimental-strip-types scripts/test-embedding-config.mjs",
    "test:processing-estimate": "node --experimental-strip-types scripts/test-processing-estimate.mjs",
    "test:local-ai-recommendation": "node --experimental-strip-types scripts/test-local-ai-recommendation.mjs",
    "test:local-storage": "node --experimental-strip-types scripts/test-local-storage-paths.mjs",
    "test:sqlite-database": "node --experimental-strip-types scripts/test-sqlite-database.mjs",
    "test:sqlite-vector": "node --experimental-strip-types scripts/test-sqlite-vector.mjs",
    "test:canonical-tags": "tsx scripts/canonical-tag-smoke.ts",
    "test:tag-similarity": "tsx scripts/tag-similarity-smoke.ts",
    "eval:evidence-search": "tsx scripts/evaluate-evidence-search.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:seed-evidence": "tsx scripts/seed-evidence-search-demo.ts",
    "test:mock-ai": "node scripts/mock-ai-provider.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.6",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-sqlite3": "13.0.2",
    "cheerio": "^1.2.0",
    "docling.rs": "^0.53.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.11.0",
    "next": "^16.2.12",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sqlite-vec": "^0.1.9",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "better-sqlite3": "13.0.2",
    "fast-uri": "3.1.5",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
