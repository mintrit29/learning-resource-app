generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum DocumentStatus {
  UPLOADED
  EXTRACTING
  EXTRACTED
  ANALYZING
  READY
  FAILED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum FileType {
  PDF
  PPTX
  DOCX
  EPUB
  IMAGE
  AUDIO
  XMIND
}

enum JobType {
  EXTRACT_TEXT
  CHUNK_DOCUMENT
  EMBED_DOCUMENT
  ANALYZE_DOCUMENT
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum DocumentTagSource {
  AI
  USER
  MERGED
}

model Document {
  id               String          @id @default(cuid())
  title            String
  originalFileName String
  fileType         FileType
  filePath         String
  fileSize         Int
  textContent      String?
  language         String?
  primaryTopic     String?
  difficulty       Difficulty?
  summary          String?
  analysisReason   String?
  status           DocumentStatus  @default(UPLOADED)
  chunks           DocumentChunk[]
  jobs             AnalysisJob[]
  tags             DocumentTag[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([primaryTopic])
}

model Tag {
  id                      String        @id @default(cuid())
  name                    String
  normalizedName          String
  description             String?
  embedding               Bytes?
  isClassificationEnabled Boolean       @default(false)
  documents               DocumentTag[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([normalizedName])
  @@index([name])
}

model DocumentTag {
  documentId String
  tagId      String
  confidence Float             @default(1)
  source     DocumentTagSource @default(AI)
  document   Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag               @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())

  @@id([documentId, tagId])
  @@index([tagId])
}

model AnalysisJob {
  id           String    @id @default(cuid())
  documentId   String
  type         JobType
  status       JobStatus @default(PENDING)
  progress     Int       @default(0)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([documentId, createdAt])
  @@index([status, type])
}

model DocumentChunk {
  id          String   @id @default(cuid())
  documentId  String
  chunkIndex  Int
  content     String
  tokenCount  Int?
  pageNumber  Int?
  sourceLabel String?
  embedding   Bytes?
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model AiProvider {
  id                    String   @id @default(cuid())
  type                  String
  displayName           String
  baseUrl               String?
  apiKeyEncrypted       String?
  defaultChatModel      String?
  defaultEmbeddingModel String?
  isActive              Boolean  @default(false)
  authStatus            String   @default("DISCONNECTED")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

}

model SearchLog {
  id                String   @id @default(cuid())
  query             String
  filters           Json?
  resultDocumentIds Json     @default("[]")
  createdAt         DateTime @default(now())

  @@index([createdAt])
}
